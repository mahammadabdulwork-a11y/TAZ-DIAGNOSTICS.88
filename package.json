{
  "name": "taz-diagnostic-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TAZ COMPANY — TAZ DIAGNOSTIC Advanced Medical Laboratory & Precision Imaging System",
  "scripts": {
    "postinstall": "npm install --prefix client && npm install --prefix server",
    "build": "npm run build --prefix client",
    "start": "node server/src/server.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "tunnel": "npx localtunnel --port 5000"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.11.5",
    "node-cron": "^4.6.0"
  }
}
